# ============================================
# LEARN2EARN - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!
# ============================================

# ============================================
# DATABASE - Turso (Production)
# ============================================
# Get your database URL and auth token from:
# https://turso.tech/app/databases
# 
# 1. Create account at turso.tech
# 2. Create a database
# 3. Run: turso db tokens create your-db-name --expiration 30d
# 4. Copy the token and URL here

TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ============================================
# FLUTTERWAVE PAYMENTS - LIVE KEYS
# ============================================
# Get your live keys from Flutterwave Dashboard:
# https://app.flutterwave.com/dashboard/settings/apis
#
# IMPORTANT: Use LIVE keys for production, TEST keys for development
# Test keys start with: FLWPUBK_TEST-xxx / FLWSECK_TEST-xxx
# Live keys start with: FLWPUBK-xxxx / FLWSECK-xxxx

# LIVE Public Key (starts with FLWPUBK-)
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# LIVE Secret Key (starts with FLWSECK-)
# WARNING: Keep this secret! Never expose in frontend code
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# LIVE Encryption Key (from Flutterwave Dashboard)
FLW_ENCRYPTION_KEY=FLWSECK-xxxxxxxxxxxxx

# ============================================
# APP CONFIGURATION
# ============================================

# Your website URL
NEXT_PUBLIC_APP_URL=https://learn2earn.co.zm

# App Name
NEXT_PUBLIC_APP_NAME=Learn2Earn

# Currency Settings (Zambian Kwacha)
NEXT_PUBLIC_CURRENCY=ZMW
NEXT_PUBLIC_CURRENCY_SYMBOL=ZMW

# ============================================
# OWNER/FOUNDER INFO
# ============================================

NEXT_PUBLIC_OWNER_NAME=George J Kasonso
NEXT_PUBLIC_OWNER_EMAIL=hello@learn2earn.co.zm
NEXT_PUBLIC_OWNER_PHONE=+260 97 123 4567
NEXT_PUBLIC_OWNER_LOCATION=Lusaka, Zambia
NEXT_PUBLIC_OWNER_HOURS=Mon–Sun, 7AM–10PM CAT

# WhatsApp number for contact/links
NEXT_PUBLIC_WHATSAPP_NUMBER=260971234567
# Format: country code + number (no + sign, no spaces)
# Example: 254115661135 for Kenya, 260971234567 for Zambia

# ============================================
# SOCIAL MEDIA LINKS
# ============================================

NEXT_PUBLIC_SOCIAL_TIKTOK=https://tiktok.com/@george_kasonso
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/george_kasonso
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@georgekasonso
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/george.kasonso
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/in/george-kasonso
NEXT_PUBLIC_SOCIAL_WEBSITE=https://georgekasonso.com

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
# Generate a random secret: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32

NEXTAUTH_SECRET=your-random-secret-key-here-minimum-32-characters-long
NEXTAUTH_URL=https://learn2earn.co.zm

# ============================================
# EMAIL SERVICE (Optional - for newsletters)
# ============================================
# Options: Resend, SendGrid, AWS SES, etc.

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@learn2earn.co.zm

# ============================================
# ANALYTICS (Optional)
# ============================================

# Google Analytics 4
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=learn2earn.co.zm

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_REVIEWS=true

# ============================================
# DEVELOPMENT ONLY
# ============================================
# These are automatically set in production

NODE_ENV=production

# ============================================
# SECURITY HEADERS (Optional)
# ============================================

# CSP Nonce for script injection protection
# CSP_NONCE=your-nonce-here
